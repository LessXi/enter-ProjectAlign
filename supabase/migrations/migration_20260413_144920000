
-- Function to look up email by display_name (for name-based login)
CREATE OR REPLACE FUNCTION lookup_email_by_name(p_name text)
RETURNS text
LANGUAGE plpgsql
SECURITY DEFINER SET search_path = public
AS $$
DECLARE
  found_email text;
BEGIN
  SELECT u.email INTO found_email
  FROM profiles p
  JOIN auth.users u ON u.id = p.id
  WHERE p.display_name = p_name
  LIMIT 1;
  RETURN found_email;
END;
$$;
